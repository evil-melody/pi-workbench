{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Pi Workbench 默认权限：核心能力 + 用系统默认应用打开成果（shell:allow-open）；replay-* 为运行记录独立回放窗口（同款前端，需同一套插件权限）",
  "windows": ["main", "replay-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "dialog:default",
    "dialog:allow-open"
  ]
}
